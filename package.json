{
  "name": "pikorua-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate --filter=@pikorua/db",
    "db:push": "turbo run db:push --filter=@pikorua/db",
    "db:studio": "turbo run db:studio --filter=@pikorua/db",
    "db:migrate": "turbo run db:migrate --filter=@pikorua/db"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.7.3"
  }
}
