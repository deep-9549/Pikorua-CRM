API_PORT=4000
DATABASE_URL=postgresql://pikorua:pikorua@localhost:5432/pikorua_crm
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
WEBSITE_LEAD_SYNC_ENABLED=false
WEBSITE_SUPABASE_URL=https://your-website-project.supabase.co
WEBSITE_SUPABASE_SERVICE_ROLE_KEY=<your-website-supabase-service-role-key>
META_WEBHOOK_VERIFY_TOKEN=<your-random-webhook-verify-token>
META_APP_SECRET=<your-meta-app-secret>
META_GRAPH_API_VERSION=v25.0
META_LEAD_SYNC_ENABLED=false
# Preferred multi-page format. Keep this on one line in Vercel.
META_PAGES=[{"page_id":"1234567890","page_name":"Pikorua Main","access_token":"<page-token-1>"},{"page_id":"9876543210","page_name":"Manager Page","access_token":"<page-token-2>"}]
# Legacy single-page fallback, used only when META_PAGES is empty/unset.
META_PAGE_ID=<your-facebook-page-id>
META_PAGE_ACCESS_TOKEN=<your-page-access-token>
CRON_SECRET=<a-random-secret-of-at-least-16-characters>
VOICE_API_BEARER_TOKEN=<your-voice-service-bearer-token>
VOICE_WEBHOOK_HMAC_SECRET=<your-voice-hmac-secret>
VOICE_ALLOWED_CLOCK_SKEW_SECONDS=300
