# ── Meta Ads webhook ──────────────────────────────────────────────────────────
META_WEBHOOK_VERIFY_TOKEN=<your-verify-token>

# ── PostgreSQL (local Docker) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://pikorua:pikorua@localhost:5432/pikorua_crm
# Connection pool size. Keep >1 so concurrent queries don't serialize.
DATABASE_MAX_CONNECTIONS=10
# Require SSL (set to "true" for Supabase / managed Postgres).
# DATABASE_SSL=true
# Set to "false" ONLY when using a transaction pooler (Supabase Supavisor :6543
# or pgBouncer transaction mode) — prepared statements aren't supported there.
# DATABASE_PREPARE=false
# Optional connection timeouts (seconds).
# DATABASE_IDLE_TIMEOUT=30
# DATABASE_CONNECT_TIMEOUT=15

# ── Redis (local Docker) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT (shared between apps/api and apps/web middleware) ────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string

# ── NestJS API ────────────────────────────────────────────────────────────────
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# ── Next.js Web ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Docker compose (production overrides) ────────────────────────────────────
# CORS_ORIGIN=https://your-domain.com
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
