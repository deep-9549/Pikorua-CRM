# Meta Ads webhook
META_WEBHOOK_VERIFY_TOKEN=<your-verify-token>

# AI Voice service ingestion (Pikorua Voice -> CRM)
VOICE_API_BEARER_TOKEN=<your-voice-service-bearer-token>
VOICE_WEBHOOK_HMAC_SECRET=<your-voice-hmac-secret>
VOICE_ALLOWED_CLOCK_SKEW_SECONDS=300

# Website Supabase lead import (runs in the API every 30 minutes)
# Keep the service-role key server-side. Never expose it through NEXT_PUBLIC_*.
WEBSITE_LEAD_SYNC_ENABLED=false
WEBSITE_SUPABASE_URL=https://your-website-project.supabase.co
WEBSITE_SUPABASE_SERVICE_ROLE_KEY=<your-website-supabase-service-role-key>

# Project microsite lead import (separate from the official brand website)
# Keep service-role keys server-side. Never expose them through NEXT_PUBLIC_*.
MICROSITE_LEAD_SYNC_ENABLED=false
MICROSITE_LEAD_SOURCES_JSON=[{"key":"project-a","label":"Project A","supabaseUrl":"https://your-microsite-project.supabase.co","serviceRoleKey":"<your-microsite-supabase-service-role-key>"}]

# PostgreSQL (local Docker)
DATABASE_URL=postgresql://pikorua:pikorua@localhost:5432/pikorua_crm
# Connection pool size. Keep >1 so concurrent queries do not serialize.
DATABASE_MAX_CONNECTIONS=10
# Require SSL (set to "true" for Supabase / managed Postgres).
# DATABASE_SSL=true
# Set to "false" ONLY when using a transaction pooler, such as Supabase
# Supavisor :6543 or pgBouncer transaction mode.
# DATABASE_PREPARE=false
# Optional connection timeouts in seconds.
# DATABASE_IDLE_TIMEOUT=30
# DATABASE_CONNECT_TIMEOUT=15

# Redis (local Docker)
REDIS_URL=redis://localhost:6379

# JWT (shared between apps/api and apps/web middleware)
JWT_SECRET=change-me-in-production-use-a-long-random-string

# NestJS API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Next.js Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional local seed admin overrides
SEED_ADMIN_EMAIL=admin@pikorua.local
SEED_ADMIN_PASSWORD=Pikorua@123
SEED_ADMIN_FULL_NAME=Local Super Admin
SEED_ADMIN_PHONE=9999999999

# Docker compose production overrides
# CORS_ORIGIN=https://your-domain.com
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
